+package com.haochen.codexremote
+
+/** Presentation only: snapshots and conversationItems remain the history authority. */
+internal fun buildConversationActivityItems(
+    items: List<ConversationItem>,
+    displayBasePath: String?,
+    imageContext: ConversationImageRenderContext,
+    showMessageTimestamps: Boolean,
+    cache: MutableMap<String, ConversationRenderCacheEntry>? = null,
+): List<ConversationRenderedItem> {
+    val userByTurn = items.filterIsInstance<ConversationItem.Bubble>()
+        .filter { it.right && !it.turnKey.isNullOrBlank() }.associate { it.turnKey to it.id }
+    val activity = linkedMapOf<String, MutableList<ConversationItem>>()
+    val owners = mutableMapOf<String, String>()
+    var lastUser: String? = null
+    items.forEach { item ->
+        if (item is ConversationItem.Bubble && item.right) lastUser = item.id
+        val isActivity = when (item) {
+            is ConversationItem.SystemNote, is ConversationItem.FileChange -> true
+            is ConversationItem.Bubble -> !item.right && item.phase == "commentary"
+        }
+        if (isActivity) {
+            val turn = when (item) {
+                is ConversationItem.Bubble -> item.turnKey
+                is ConversationItem.SystemNote -> item.turnKey
+                is ConversationItem.FileChange -> item.turnId
+            }
+            // A known foreign turn must never be attributed to the latest user.
+            val owner = if (turn.isNullOrBlank()) lastUser else userByTurn[turn]
+            if (owner != null) {
+                owners[item.id] = owner
+                activity.getOrPut(owner) { mutableListOf() }.add(item)
+            }
+        }
+    }
+    val used = mutableSetOf<String>()
+    fun render(item: ConversationItem): ConversationRenderedItem {
+        val signature = buildConversationRenderSignature(item, displayBasePath, imageContext, showMessageTimestamps)
+        used.add(item.id)
+        val old = cache?.get(item.id)
+        if (old?.signature == signature) return old.renderedItem
+        val rendered = buildConversationRenderedItem(item, displayBasePath, imageContext, showMessageTimestamps)
+        cache?.set(item.id, ConversationRenderCacheEntry(signature, rendered))
+        return rendered
+    }
+    val result = buildList {
+        items.forEach { item ->
+            if (item.id in owners) return@forEach
+            add(render(item))
+            if (item is ConversationItem.Bubble && item.right) {
+                val steps = activity[item.id].orEmpty()
+                if (steps.isNotEmpty()) {
+                    val id = "activity_${item.id}"
+                    val body = steps.joinToString("") { render(it).html }
+                    val safeId = escapeConversationHtmlAttribute(id)
+                    val html = """
+                        <details class="cr-activity" data-activity-id="$safeId">
+                          <summary><span>Actividad · ${steps.size} ${if (steps.size == 1) "paso" else "pasos"}</span><span class="cr-activity-hint">Ver detalles</span></summary>
+                          <section class="cr-activity-content">$body</section>
+                        </details>
+                    """.trimIndent()
+                    add(ConversationRenderedItem(id, "activity", wrapConversationRenderedItem(id, "activity", html)))
+                }
+            }
+        }
+    }
+    cache?.keys?.removeAll { it !in used }
+    return result
+}
