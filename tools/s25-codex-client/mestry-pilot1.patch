+package com.haochen.codexremote
+
+import org.json.JSONObject
+
+internal data class DriveFolder(val id: String, val name: String, val enabled: Boolean, val available: Boolean = true) {
+    companion object {
+        fun fromJson(value: JSONObject): DriveFolder? {
+            val id = value.optString("id")
+            if (!id.matches(Regex("[A-Za-z0-9_-]{10,100}"))) return null
+            return DriveFolder(id, value.optString("name"), value.optBoolean("enabled"), value.optBoolean("available", true))
+        }
+    }
+}
+
+internal data class DriveFile(val id: String, val name: String, val folder: Boolean, val mime: String) {
+    val url: String get() = if (folder) "https://drive.google.com/drive/folders/$id" else "https://drive.google.com/file/d/$id/view"
+    companion object {
+        fun fromJson(value: JSONObject): DriveFile? {
+            val id = value.optString("id")
+            if (!id.matches(Regex("[A-Za-z0-9_-]{10,100}"))) return null
+            return DriveFile(id, value.optString("name"), value.optBoolean("folder"), value.optString("mime_type"))
+        }
+    }
+}
+
