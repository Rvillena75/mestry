+package com.haochen.codexremote
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.SharedPreferences
+import android.net.Uri
+import android.os.Build
+import org.json.JSONObject
+
+internal fun MainActivity.initializeAutomaticVpn() {
+    automaticVpnEnabled = MestryVpnService.enabled(this)
+    privateSshHost = prefs.getString(MestryVpnService.HOST, "").orEmpty()
+    val state = getSharedPreferences("mestry_vpn_private", Context.MODE_PRIVATE)
+    automaticVpnStatus = MestryVpnService.status(this)
+    vpnStatusListener = SharedPreferences.OnSharedPreferenceChangeListener { _, key ->
+        if (key == "status") mainHandler.post { automaticVpnStatus = MestryVpnService.status(this) }
+    }
+    state.registerOnSharedPreferenceChangeListener(vpnStatusListener)
+    vpnStatusReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context?, intent: Intent?) {
+            if (intent?.getBooleanExtra("stopped", false) != true) return
+            vpnReconnectAllowed = false
+            disconnectBridge(detail = "Conexión privada cerrada", switchToConnectionPage = false)
+        }
+    }
+    val filter = IntentFilter(MestryVpnService.UI_STATUS)
+    if (Build.VERSION.SDK_INT >= 33) registerReceiver(vpnStatusReceiver, filter, Context.RECEIVER_NOT_EXPORTED)
+    else registerReceiver(vpnStatusReceiver, filter)
+}
+
+internal fun MainActivity.startAutomaticVpn() {
+    if (!automaticVpnEnabled) return
+    vpnReconnectAllowed = true
+    MestryVpnService.foreground(this)
+}
+
+internal fun MainActivity.leaveAutomaticVpn() {
+    if (!automaticVpnEnabled) return
+    MestryVpnService.background(this, activeSessionId, activeTurnId, connected)
+    // The service retains only task identifiers and observes an active task.
+    // A new authoritative snapshot restores the UI after returning.
+    stopSessionSyncLoop()
+    cancelReconnectSchedule(resetAttempt = false)
+    bridgeGeneration += 1
+    disconnectRequested = true
+    bridgeClient?.close()
+    bridgeClient = null
+    connected = false
+    pendingRequests.clear()
+}
+
+internal fun MainActivity.disposeAutomaticVpn() {
+    vpnStatusReceiver?.let { runCatching { unregisterReceiver(it) } }
+    vpnStatusListener?.let {
+        getSharedPreferences("mestry_vpn_private", Context.MODE_PRIVATE).unregisterOnSharedPreferenceChangeListener(it)
+    }
+}
+
+internal fun MainActivity.observeVpnMessage(message: JSONObject) {
+    if (!automaticVpnEnabled) return
+    if (message.optString("type") == "hello") MestryVpnService.connection(this, true)
+    if (message.optString("type") != "event") return
+    val event = message.optString("event")
+    if (event != "turn/started" && event != "turn/completed") return
+    val payload = message.optJSONObject("payload")
+    val session = firstNonEmpty(message.optString("session_id"), message.optString("thread_id"), activeSessionId.orEmpty())
+    val turn = firstNonEmpty(message.optString("turn_id"), payload?.optJSONObject("turn")?.optString("id").orEmpty())
+    MestryVpnService.task(this, session, turn, event == "turn/completed")
+}
+
+internal fun validPrivateSshHost(value: String): Boolean {
+    val parts = value.split(".").map { it.toIntOrNull() ?: return false }
+    return parts.size == 4 && parts[0] == 100 && parts[1] in 64..127 &&
+        parts[2] in 0..255 && parts[3] in 0..255
+}
+
+internal fun MainActivity.savePrivateSshHost() {
+    if (!validPrivateSshHost(privateSshHost.trim())) {
+        showNotice("Introduce la IP privada de Tailscale del S23")
+        return
+    }
+    privateSshHost = privateSshHost.trim()
+    prefs.edit().putString(MestryVpnService.HOST, privateSshHost).apply()
+    showNotice("Servidor privado guardado")
+}
+
+internal fun MainActivity.updateAutomaticVpn(enabled: Boolean) {
+    if (enabled && !validPrivateSshHost(privateSshHost.trim())) {
+        showNotice("Primero guarda la IP privada del S23")
+        return
+    }
+    automaticVpnEnabled = enabled
+    prefs.edit().putBoolean(MestryVpnService.ENABLED, enabled).apply()
+    if (enabled) startAutomaticVpn()
+    else {
+        vpnReconnectAllowed = false
+        MestryVpnService.stop(this)
+    }
+}
+
+internal fun MainActivity.openPrivateSshTransport() {
+    if (!validPrivateSshHost(privateSshHost.trim())) {
+        showNotice("Primero guarda la IP privada del S23")
+        return
+    }
+    val uri = Uri.parse("ssh://u0_a348@" + privateSshHost.trim() + ":8023/#Mestry%20s23%208023")
+    runCatching { startActivity(Intent(Intent.ACTION_VIEW, uri).setPackage("org.connectbot")) }
+        .onFailure { showNotice("No se pudo abrir la conexión con el S23") }
+}
