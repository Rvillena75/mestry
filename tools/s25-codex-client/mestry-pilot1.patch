+package com.haochen.codexremote
+
+import org.json.JSONObject
+
+private fun MainActivity.driveCall(type: String, payload: JSONObject, done: (JSONObject) -> Unit) {
+    val panel = driveBrowser?.identity
+    val connection = currentConnectionId
+    if (!connected) return
+    sendRequest(type, payload, object : ResponseHandler {
+        override fun onResponse(response: JSONObject) {
+            if (connection != currentConnectionId || (panel != null && driveBrowser?.identity != panel)) return
+            done(response.optJSONObject("payload") ?: JSONObject())
+        }
+        override fun onError(errorText: String) {
+            if (connection != currentConnectionId || (panel != null && driveBrowser?.identity != panel)) return
+            val text = if (errorText.contains("NOT_GRANTED_OR_UNAVAILABLE")) {
+                "Google no permite acceder a ese elemento. Debe estar autorizado a MESTRY."
+            } else if (errorText.contains("DISABLED")) {
+                "La carpeta está desactivada en MESTRY. Puedes activarla en Carpetas."
+            } else "No se pudo completar la operación de Drive. $errorText"
+            driveBrowser = driveBrowser?.copy(loading = false, error = text, document = driveBrowser?.document?.copy(loading = false))
+            if (panel != null) showNotice(text)
+        }
+        override fun suppressDefaultErrorUi() = true
+    })
+}
+
+private fun MainActivity.applyDriveState(value: JSONObject) {
+    val folders = value.optJSONArray("folders")
+    driveFolders.clear()
+    if (folders != null) for (index in 0 until folders.length()) {
+        folders.optJSONObject(index)?.let(DriveFolder::fromJson)?.let(driveFolders::add)
+    }
+    driveAssignments.clear()
+    val assignments = value.optJSONArray("assignments")
+    if (assignments != null) for (index in 0 until assignments.length()) {
+        val row = assignments.optJSONObject(index) ?: continue
+        val folder = row.optJSONObject("folder")?.let(DriveFolder::fromJson) ?: continue
+        val project = row.optString("project")
+        if (project.isNotBlank()) driveAssignments[project] = folder
+    }
+    val panel = driveBrowser
+    if (panel?.root != null && driveFolders.none { it.id == panel.root.id && it.enabled }) {
+        driveBrowser = panel.copy(
+            mode = if (panel.mode == DriveBrowserMode.Manage) DriveBrowserMode.Manage else DriveBrowserMode.Choose,
+            root = null, path = emptyList(), files = emptyList(), document = null,
+        )
+    }
+}
+
+internal fun MainActivity.requestDriveState() {
+    driveCall("drive.state", JSONObject()) { applyDriveState(it) }
+}
+
+internal fun MainActivity.openDriveBrowser(project: String?) {
+    if (!ensureConnected()) return
+    driveBrowser = DriveBrowserState(project = project, loading = true)
+    driveCall("drive.state", JSONObject()) { value ->
+        applyDriveState(value)
+        driveBrowser = driveBrowser?.copy(loading = false)
+        val selected = project?.let(driveAssignments::get)
+        if (selected != null) openDriveRoot(selected, assign = false)
+    }
+}
+
+internal fun MainActivity.openDriveRoot(folder: DriveFolder, assign: Boolean) {
+    val state = driveBrowser ?: return
+    if (!folder.enabled || !folder.available) return
+    fun browse() {
+        driveBrowser = driveBrowser?.copy(root = folder, mode = DriveBrowserMode.Browse, document = null)
+        val root = DriveFile(folder.id, folder.name, true, "application/vnd.google-apps.folder")
+        browseDriveFolder(listOf(root))
+    }
+    if (assign && state.project != null) {
+        driveBrowser = state.copy(loading = true, error = null)
+        driveCall("drive.assign", JSONObject().put("project", state.project).put("folder_id", folder.id)) {
+            applyDriveState(it)
+            browse()
+        }
+    } else browse()
+}
+
+internal fun MainActivity.browseDriveFolder(path: List<DriveFile>, more: Boolean = false) {
+    val state = driveBrowser ?: return
+    val root = state.root ?: return
+    val folder = path.lastOrNull() ?: return
+    val before = if (more) state.files else emptyList()
+    driveBrowser = state.copy(mode = DriveBrowserMode.Browse, path = path, files = before, loading = true, error = null, document = null)
+    val payload = JSONObject().put("root_id", root.id).put("folder_id", folder.id)
+        .put("page_token", if (more) state.nextPageToken else "")
+    driveCall("drive.list", payload) { result ->
+        val current = driveBrowser ?: return@driveCall
+        if (current.root?.id != root.id || current.path.lastOrNull()?.id != folder.id) return@driveCall
+        val files = result.optJSONArray("files")
+        val listed = buildList<DriveFile> {
+            if (files != null) for (index in 0 until files.length()) files.optJSONObject(index)?.let(DriveFile::fromJson)?.let(::add)
+        }
+        driveBrowser = current.copy(files = (before + listed).distinctBy { it.id }, loading = false,
+            nextPageToken = result.optString("next_page_token"), incomplete = result.optBoolean("incomplete"))
+    }
+}
+
+internal fun MainActivity.readDriveFile(file: DriveFile) {
+    val state = driveBrowser ?: return
+    if (file.folder) {
+        browseDriveFolder(state.path + file)
+        return
+    }
+    val root = state.root ?: return
+    driveBrowser = state.copy(document = DriveDocument(file), loading = true, error = null)
+    driveCall("drive.read", JSONObject().put("root_id", root.id).put("file_id", file.id)) { result ->
+        val current = driveBrowser ?: return@driveCall
+        if (current.document?.file?.id != file.id) return@driveCall
+        val text = if (result.has("text") && !result.isNull("text")) result.optString("text") else null
+        driveBrowser = current.copy(loading = false, document = DriveDocument(file, text, loading = false))
+    }
+}
+
+internal fun MainActivity.setDriveFolderEnabled(folderId: String, enabled: Boolean) {
+    driveBrowser = driveBrowser?.copy(loading = true, error = null)
+    driveCall("drive.folder.enable", JSONObject().put("folder_id", folderId).put("enabled", enabled)) {
+        applyDriveState(it)
+        driveBrowser = driveBrowser?.copy(loading = false)
+    }
+}
+
+internal fun MainActivity.removeDriveAssignment() {
+    val project = driveBrowser?.project ?: return
+    driveBrowser = driveBrowser?.copy(loading = true, error = null)
+    driveCall("drive.assign", JSONObject().put("project", project).put("folder_id", JSONObject.NULL)) {
+        applyDriveState(it)
+        driveBrowser = driveBrowser?.copy(mode = DriveBrowserMode.Choose, root = null, path = emptyList(), files = emptyList(), loading = false)
+    }
+}
