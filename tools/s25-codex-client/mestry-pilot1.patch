@@ -0,0 +1,46 @@
+package com.haochen.codexremote;
+
+/** Timing decisions only. Uses elapsed time, independent of wall-clock changes. */
+public final class VpnLeasePolicy {
+    public static final long EXIT_GRACE_MS = 30_000;
+    public static final long START_TIMEOUT_MS = 60_000;
+    public static final long LOST_TIMEOUT_MS = 90_000;
+    private boolean requested, foreground, connected, everConnected;
+    private long connectDeadline, backgroundDeadline = Long.MAX_VALUE, lostAt = -1;
+    private int tasks;
+
+    public boolean enterForeground(long now) {
+        boolean fresh = !requested;
+        if (fresh) {
+            requested = true;
+            connected = everConnected = false;
+            connectDeadline = now + START_TIMEOUT_MS;
+            lostAt = -1;
+        }
+        foreground = true;
+        backgroundDeadline = Long.MAX_VALUE;
+        return fresh;
+    }
+    public void leaveForeground(long now) {
+        if (foreground) backgroundDeadline = now + EXIT_GRACE_MS;
+        foreground = false;
+    }
+    public void confirmConnection() { connected = everConnected = true; lostAt = -1; }
+    public void loseConnection(long now) {
+        if (connected || lostAt < 0) lostAt = now;
+        connected = false;
+    }
+    public void taskCount(int count) { tasks = Math.max(0, count); }
+    public void manualDisconnect() { requested = false; }
+    public boolean foreground() { return foreground; }
+    public boolean connected() { return connected; }
+    public boolean requested() { return requested; }
+    public int taskCount() { return tasks; }
+    public String stopReason(long now) {
+        if (!requested) return "manual";
+        if (!foreground && tasks == 0 && now >= backgroundDeadline) return "background";
+        if (!connected && !everConnected && now >= connectDeadline) return "unreachable";
+        if (!connected && everConnected && lostAt >= 0 && now - lostAt >= LOST_TIMEOUT_MS) return "connection_lost";
+        return "";
+    }
+}
