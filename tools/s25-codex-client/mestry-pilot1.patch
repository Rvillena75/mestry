@@ -0,0 +1,34 @@
+package com.haochen.codexremote;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+/** Only opaque task/session identifiers; no commands, messages or credentials. */
+public final class VpnTurnTracker {
+    private final Map<String, Set<String>> turns = new HashMap<>();
+    private static boolean valid(String value) {
+        return value != null && value.matches("[A-Za-z0-9_-]{1,128}");
+    }
+    public void started(String session, String turn) {
+        if (!valid(session) || !valid(turn) || (!turns.containsKey(session) && turns.size() >= 32)) return;
+        Set<String> active = turns.computeIfAbsent(session, key -> new HashSet<>());
+        if (active.size() < 32) active.add(turn);
+    }
+    public void completed(String session, String turn) {
+        Set<String> active = turns.get(session);
+        if (active == null) return;
+        active.remove(turn);
+        if (active.isEmpty()) turns.remove(session);
+    }
+    public void replace(String session, Set<String> active) {
+        if (!valid(session)) return;
+        turns.remove(session);
+        for (String turn : active) started(session, turn);
+    }
+    public Set<String> sessions() { return new HashSet<>(turns.keySet()); }
+    public Set<String> active(String session) { return new HashSet<>(turns.getOrDefault(session, new HashSet<>())); }
+    public int count() { return turns.values().stream().mapToInt(Set::size).sum(); }
+    public void clear() { turns.clear(); }
+}
