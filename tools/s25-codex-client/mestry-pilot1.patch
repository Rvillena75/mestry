+                if (observer != null && !observerReady && now - observerStarted >= 5_000) {
+                    closeObserver(); policy.loseConnection(now); retryAfter = now + 3_000;
+                }
+            } else closeObserver();
+            String text = tasks.count() > 0 && !policy.foreground()
+                ? "Manteniendo la conexión hasta que termine la tarea"
+                : policy.connected() ? "Conexión de MESTRY activa" : "Conectando con el S23";
+            updateStatus(text);
+            persist();
+            handler.postDelayed(this, 1000);
+        }
+    };
+    private void openObserver(long now) {
+        observerStarted = now;
+        final long generation = ++observerGeneration;
+        try {
+            String token = new BridgeTokenVault(this).read();
+            BridgeTransport.setToken(token);
+            observer = new BridgeClient(URI.create("ws://127.0.0.1:18787/"), new BridgeClient.Listener() {
+                @Override public void onOpen() { }
+                @Override public void onText(String text) { handler.post(() -> { if (generation == observerGeneration) consume(text); }); }
+                @Override public void onDisconnected(int code, String reason, Throwable error) {
+                    handler.post(() -> {
+                        if (generation != observerGeneration) return;
+                        closeObserver();
+                        policy.loseConnection(SystemClock.elapsedRealtime());
+                        retryAfter = SystemClock.elapsedRealtime() + 3_000;
+                    });
+                }
+            }, 3, 15);
+            observer.connect();
+        } catch (Exception error) {
+            closeObserver(); policy.loseConnection(now); retryAfter = now + 3_000;
+        }
+    }
+    private void consume(String text) {
+        if (finishing || policy.foreground() || observer == null) return;
+        try {
+            JSONObject message = new JSONObject(text);
+            String type = message.optString("type");
+            JSONObject payload = message.optJSONObject("payload");
+            if ("hello".equals(type)) {
+                if (payload == null || !"mestry-s25-pilot".equals(payload.optString("name"))) {
+                    closeObserver(); policy.loseConnection(SystemClock.elapsedRealtime()); return;
+                }
+                observerReady = true;
+                policy.confirmConnection();
+                requestSnapshots(SystemClock.elapsedRealtime());
+            } else if ("event".equals(type)) {
+                String event = message.optString("event");
+                String session = message.optString("session_id");
+                String turn = message.optString("turn_id");
+                if (turn.isEmpty() && payload != null && payload.optJSONObject("turn") != null)
+                    turn = payload.getJSONObject("turn").optString("id");
+                if ("turn/started".equals(event)) tasks.started(session, turn);
+                if ("turn/completed".equals(event)) tasks.completed(session, turn);
+            } else if ("response".equals(type)) {
+                String session = pendingSnapshots.remove(message.optString("id"));
+                if (session != null && message.optBoolean("ok", false) && payload != null) {
+                    JSONArray active = payload.optJSONArray("active_turns");
+                    // Missing metadata never becomes a false "task finished".
+                    if (active != null && session.equals(payload.optString("session_id"))) {
+                        Set<String> ids = new HashSet<>();
+                        for (int i = 0; i < active.length(); i++) {
+                            JSONObject turn = active.optJSONObject(i);
+                            if (turn != null) ids.add(turn.optString("turn_id"));
+                        }
+                        tasks.replace(session, ids);
+                    }
+                }
+            }
+            policy.taskCount(tasks.count());
+            persist();
+        } catch (Exception ignored) { /* No payloads or credentials in diagnostics. */ }
+    }
+    private void requestSnapshots(long now) {
+        if (observer == null || !observerReady) return;
+        lastSnapshot = now;
+        if (pendingSnapshots.size() > 32) { closeObserver(); return; }
+        for (String session : tasks.sessions()) {
+            if (pendingSnapshots.containsValue(session)) continue;
+            try {
+                String id = "vpn-status-" + (++requestNumber);
+                JSONObject request = new JSONObject().put("type", "request").put("id", id)
+                    .put("method", "session.content").put("payload", new JSONObject().put("session_id", session));
+                pendingSnapshots.put(id, session);
+                observer.sendText(request.toString());
+            } catch (Exception ignored) { closeObserver(); break; }
+        }
+    }
+    private void closeObserver() {
+        observerGeneration++;
+        BridgeClient previous = observer;
+        observer = null; observerReady = false; pendingSnapshots.clear();
+        if (previous != null) previous.close();
+    }
+    private void persist() {
+        JSONObject saved = new JSONObject();
+        for (String session : tasks.sessions()) {
+            try { saved.put(session, new JSONArray(tasks.active(session))); } catch (Exception ignored) { }
+        }
+        state.edit().putBoolean("running", true).putString("tasks", saved.toString()).apply();
+    }
+    private void restoreTasks() {
+        try {
+            JSONObject saved = new JSONObject(state.getString("tasks", "{}"));
+            java.util.Iterator<String> names = saved.keys();
+            while (names.hasNext()) {
+                String session = names.next();
+                JSONArray ids = saved.optJSONArray(session);
+                if (ids != null) for (int i = 0; i < ids.length(); i++) tasks.started(session, ids.optString(i));
+            }
+        } catch (Exception ignored) { }
+    }
+    private Notification notification(String text) {
+        PendingIntent open = PendingIntent.getActivity(this, 0,
+            new Intent(this, MainActivity.class), PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+        PendingIntent stop = PendingIntent.getService(this, 1,
+            new Intent(this, MestryVpnService.class).setAction(STOP),
+            PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+        return new Notification.Builder(this, CHANNEL)
+            .setSmallIcon(android.R.drawable.stat_sys_upload_done)
+            .setContentTitle("Conexión privada MESTRY").setContentText(text)
+            .setContentIntent(open).setOngoing(true)
+            .addAction(new Notification.Action.Builder(null, "Desconectar", stop).build()).build();
+    }
+    private void updateStatus(String text) {
+        state.edit().putString("status", text).apply();
+        if (!text.equals(notificationText)) {
+            notificationText = text;
+            getSystemService(NotificationManager.class).notify(NOTIFICATION_ID, notification(text));
+        }
+    }
+    private void finishLease(String reason) {
+        if (finishing) return;
+        finishing = true;
+        handler.removeCallbacksAndMessages(null);
+        closeObserver();
+        boolean sent = !state.getBoolean("owned", false) || sendVpn(false);
+        state.edit().putBoolean("running", false).putBoolean("owned", !sent)
+            .putString("tasks", "{}").putString("status", "VPN automática apagada")
+            .putString("last_stop_reason", reason).apply();
+        sendBroadcast(new Intent(UI_STATUS).setPackage(getPackageName()).putExtra("stopped", true).putExtra("reason", reason));
+        stopForeground(STOP_FOREGROUND_REMOVE);
+        stopSelf();
+    }
+    @Override public void onTaskRemoved(Intent rootIntent) {
+        policy.leaveForeground(SystemClock.elapsedRealtime());
+        persist();
+        super.onTaskRemoved(rootIntent);
+    }
+    @Override public void onDestroy() {
+        handler.removeCallbacksAndMessages(null);
+        closeObserver();
+        super.onDestroy();
+    }
+    @Override public IBinder onBind(Intent intent) { return null; }
+}
