+import { spawn } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const FIELDS = {
+  'drive.state': [], 'drive.folder.enable': ['folder_id', 'enabled'],
+  'drive.assign': ['project', 'folder_id'], 'drive.list': ['root_id', 'folder_id', 'page_token'],
+  'drive.read': ['root_id', 'file_id'],
+};
+
+export function driveRequest(type, payload) {
+  const fields = FIELDS[type];
+  const keys = Object.keys(payload ?? {});
+  if (!fields || !payload || typeof payload !== 'object' || Array.isArray(payload) ||
+      keys.length !== fields.length || fields.some((key) => !Object.hasOwn(payload, key))) {
+    throw new Error('DRIVE_REQUEST_FIELDS');
+  }
+  const result = { schema: 1, op: type.slice(6), ...payload };
+  if (Buffer.byteLength(JSON.stringify(result)) > 10000) throw new Error('DRIVE_REQUEST_TOO_LARGE');
+  return result;
+}
+
+/** Fixed executable, argv and SSH capability; never a shell or a Codex turn. */
+export class DriveClient {
+  async request(type, payload) {
+    const body = JSON.stringify(driveRequest(type, payload));
+    return new Promise((resolve, reject) => {
+      const child = spawn('/usr/bin/python3', ['-I', fileURLToPath(new URL('./mestry-drive-client.py', import.meta.url))],
+        { stdio: ['pipe', 'pipe', 'ignore'] });
+      const chunks = [];
+      let bytes = 0;
+      const timer = setTimeout(() => { child.kill('SIGTERM'); reject(new Error('DRIVE_REQUEST_TIMEOUT')); }, 145000);
+      child.once('error', () => { clearTimeout(timer); reject(new Error('DRIVE_CAPABILITY_UNAVAILABLE')); });
+      child.stdin.on('error', () => {});
+      child.stdout.on('data', (chunk) => {
+        bytes += chunk.length;
+        if (bytes > 1000000) { child.kill('SIGTERM'); reject(new Error('DRIVE_RESPONSE_TOO_LARGE')); }
+        else chunks.push(chunk);
+      });
+      child.once('close', () => {
+        clearTimeout(timer);
+        try {
+          const result = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+          if (!['OK', 'OPEN_IN_DRIVE'].includes(result?.status)) {
+            const code = /^[A-Z0-9_]+$/.test(result?.code ?? '') ? result.code : 'DRIVE_REQUEST_FAILED';
+            reject(new Error(code));
+          } else resolve(result);
+        } catch { reject(new Error('DRIVE_RESPONSE_INVALID')); }
+      });
+      child.stdin.end(body);
+    });
+  }
+}
