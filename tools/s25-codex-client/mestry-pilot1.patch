+  const m = JSON.parse(line);
+  if (m.method === 'initialized') { initialized = true; continue; }
+  let result = {};
+  if (m.method !== 'initialize' && !initialized) { process.stdout.write(JSON.stringify({id:m.id,error:{code:-32600,message:'initialized missing'}})+'\\n'); continue; }
+  if (m.method === 'account/read') result = { account: { type: 'chatgpt' } };
+  if (m.method === 'thread/list') result = { data: [], nextCursor: null };
+  if (['thread/start', 'thread/resume'].includes(m.method)) {
+    if (m.params.ephemeral === null || m.params.excludeTurns === null) { process.stdout.write(JSON.stringify({id:m.id,error:{code:-32600,message:'Invalid request: invalid type: null, expected a boolean'}})+'\\n'); continue; }
+    result = { thread: { id: 'fixture-thread', cwd: root }, cwd: root, approvalPolicy: m.params.approvalPolicy, extended: m.params.persistExtendedHistory, sandbox: { type: 'dangerFullAccess' }, params: m.params };
+  }
+  if (m.method === 'turn/start') result = { turn: { id: 'fixture-turn', params: m.params } };
+  process.stdout.write(JSON.stringify({ id:m.id, result })+'\\n');
+}
+`, { mode: 0o700 });
