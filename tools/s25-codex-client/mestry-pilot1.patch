+/** Owns the requested VPN lease; never owns SSH keys or model turns. */
+public final class MestryVpnService extends Service {
+    public static final String ENABLED = "mestry_auto_vpn";
+    public static final String HOST = "mestry_private_host";
+    public static final String UI_STATUS = "com.haochen.codexremote.VPN_STATUS";
+    private static final String FOREGROUND = "foreground", BACKGROUND = "background";
+    private static final String UPDATE = "update", EVENT = "event", STOP = "stop";
+    private static final String CHANNEL = "mestry_private_connection";
+    private static final int NOTIFICATION_ID = 3047;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final VpnLeasePolicy policy = new VpnLeasePolicy();
+    private final VpnTurnTracker tasks = new VpnTurnTracker();
+    private final Map<String, String> pendingSnapshots = new HashMap<>();
+    private SharedPreferences state;
+    private BridgeClient observer;
+    private boolean observerReady, finishing;
+    private long lastSnapshot, retryAfter, observerStarted;
+    private int requestNumber;
+    private long observerGeneration;
+    private String notificationText = "";
+
+    public static boolean enabled(Context context) {
+        return context.getSharedPreferences("codex_remote_settings", MODE_PRIVATE).getBoolean(ENABLED, false);
+    }
+    private static SharedPreferences storage(Context context) {
+        return context.getSharedPreferences("mestry_vpn_private", MODE_PRIVATE);
+    }
+    private static void reportFailure(Context context) {
+        storage(context).edit().putString("status", "No se pudo iniciar la conexión privada").apply();
+    }
+    public static void foreground(Context context) {
+        if (!enabled(context)) return;
+        try { context.startForegroundService(new Intent(context, MestryVpnService.class).setAction(FOREGROUND)); }
+        catch (RuntimeException error) { reportFailure(context); }
+    }
+    private static void update(Context context, Intent intent) {
+        if (!storage(context).getBoolean("running", false)) return;
+        try { context.startService(intent); } catch (RuntimeException error) { reportFailure(context); }
+    }
+    public static void background(Context context, String session, String turn, boolean connected) {
+        update(context, new Intent(context, MestryVpnService.class).setAction(BACKGROUND)
+            .putExtra("session", session).putExtra("turn", turn).putExtra("connected", connected));
+    }
+    public static void connection(Context context, boolean connected) {
+        update(context, new Intent(context, MestryVpnService.class).setAction(UPDATE).putExtra("connected", connected));
+    }
+    public static void task(Context context, String session, String turn, boolean completed) {
+        update(context, new Intent(context, MestryVpnService.class).setAction(EVENT)
+            .putExtra("session", session).putExtra("turn", turn).putExtra("completed", completed));
+    }
+    public static void stop(Context context) {
+        update(context, new Intent(context, MestryVpnService.class).setAction(STOP));
+    }
+    public static String status(Context context) {
+        return storage(context).getString("status", "VPN automática apagada");
+    }
+    @Override public void onCreate() {
+        super.onCreate();
+        state = storage(this);
+        getSystemService(NotificationManager.class).createNotificationChannel(
+            new NotificationChannel(CHANNEL, "Conexión privada MESTRY", NotificationManager.IMPORTANCE_LOW));
+    }
+    @Override public int onStartCommand(Intent intent, int flags, int startId) {
+        if (finishing) return START_NOT_STICKY;
+        startForeground(NOTIFICATION_ID, notification("Preparando la conexión privada"));
+        long now = SystemClock.elapsedRealtime();
+        if (intent == null) {
+            if (!state.getBoolean("owned", false) || !enabled(this)) {
+                finishLease("stopped");
+                return START_NOT_STICKY;
+            }
+            restoreTasks();
+            policy.enterForeground(now);
+            policy.leaveForeground(now);
+        } else {
+            String action = intent.getAction();
+            if (STOP.equals(action) || !enabled(this)) {
+                policy.manualDisconnect();
+                finishLease("manual");
+                return START_NOT_STICKY;
+            }
+            if (FOREGROUND.equals(action)) {
+                closeObserver();
+                boolean fresh = policy.enterForeground(now);
+                if (fresh) {
+                    if (!sendVpn(true)) {
+                        finishLease("tailscale_required");
+                        return START_NOT_STICKY;
+                    }
+                    state.edit().putBoolean("owned", true).apply();
+                }
+            } else if (BACKGROUND.equals(action)) {
+                tasks.started(intent.getStringExtra("session"), intent.getStringExtra("turn"));
+                if (intent.getBooleanExtra("connected", false)) policy.confirmConnection();
+                policy.leaveForeground(now);
+            } else if (UPDATE.equals(action)) {
+                if (policy.foreground()) {
+                    if (intent.getBooleanExtra("connected", false)) policy.confirmConnection();
+                    else policy.loseConnection(now);
+                }
+            } else if (EVENT.equals(action)) {
+                String session = intent.getStringExtra("session"), turn = intent.getStringExtra("turn");
+                if (intent.getBooleanExtra("completed", false)) tasks.completed(session, turn);
+                else tasks.started(session, turn);
